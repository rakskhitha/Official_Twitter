# Copy this file to .env and fill in the values. Never commit .env.

# App-only Bearer Token from https://console.x.com (your App -> Keys and tokens)
X_BEARER_TOKEN=

# PostgreSQL connection string (database must already exist); only used when outputs.postgres is on
POSTGRES_DSN=postgresql://postgres:password@localhost:5432/x_monitor

# Pipeline database (twitter_posts / twitter_profiles / twitter_pipeline_runs); used when outputs.pipeline is on
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
